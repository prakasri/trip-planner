# Neon Postgres connection strings — DATABASE_URL is the pooled endpoint
# (used by the app at runtime via @prisma/adapter-neon); DIRECT_URL is the
# unpooled endpoint (used only by `prisma migrate`). Neon's dashboard gives
# you both — the pooled one has "-pooler" in the hostname.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# 32+ character random string used to sign/encrypt the iron-session cookie
SESSION_SECRET="replace-with-a-long-random-string"

# The frontend's origin, used for CORS and the Origin-header CSRF check.
# development: http://localhost:3000
ALLOWED_ORIGIN="http://localhost:3000"
